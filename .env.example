# ============================================
# NEXTAUTH EMAIL MAGIC-LINK AUTH
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_strong_random_secret
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ============================================
# JITSI CONFIGURATION
# ============================================
# Self-hosted Jitsi domain with protocol
# 
# Development scenarios:
# - HTTP (local testing): http://meet.melanam.com
# - Auto-detect (uses same protocol as your app): meet.melanam.com
#
# Production scenarios:
# - HTTPS (recommended): https://melanam.com
# - Main domain with HTTPS: https://melanam.com
#
# The component automatically tries both HTTP and HTTPS if one fails
NEXT_PUBLIC_JITSI_DOMAIN=meet.melanam.com

# ============================================
# JIBRI CONFIGURATION (Recording & Streaming)
# ============================================
# Jibri service URL for video recording and YouTube livestream
# Default: http://localhost:2222 for local development
# Production: Use your Jibri deployment URL
JIBRI_SERVICE_URL=http://localhost:2222

# Jibri API secret for authentication
# This should be a strong secret configured on your Jibri instance
JIBRI_API_SECRET=your_jibri_api_secret

# Recording output path (on the Jibri server)
JIBRI_RECORDINGS_PATH=/tmp/jibri-recordings

# ============================================
# YOUTUBE LIVESTREAM CONFIGURATION
# ============================================
# YouTube livestream is enabled when JIBRI_API_SECRET is configured
# To use YouTube livestream:
# 1. Go to YouTube Studio
# 2. Navigate to "Go Live" in the left sidebar
# 3. Copy the stream URL (rtmps://a.rtmp.youtube.com/live2/xxx)
# 4. Users will paste this URL via the YouTube button in the meeting navbar

# ============================================
# MEETING AI / LIVE CAPTIONS
# ============================================
# WebSocket endpoint for the realtime caption service
# If you proxy the backend through the same domain, set it to that ws/wss URL.
NEXT_PUBLIC_MEETING_AI_WS_URL=ws://localhost:4010

# Optional explicit HTTP endpoint for caption control calls
NEXT_PUBLIC_MEETING_AI_CONTROL_URL=http://localhost:4010

# Backend service settings
MEETING_AI_PORT=4010
MEETING_AI_HOST=0.0.0.0
MEETING_AI_CORS_ORIGIN=http://localhost:3000

# ============================================
# BOT + ASSEMBLYAI CAPTION PIPELINE
# ============================================
# Required for realtime bot transcription pipeline
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# ============================================
# MELANAM LEARNING STUDIO / GEMINI
# ============================================
# Server-side only. Public YouTube URLs are passed directly to Gemini for
# transcript extraction and learning-content generation.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_STUDIO_MODEL=gemini-2.5-flash

# Optional fallback alias
AAI_API_KEY=your_assemblyai_api_key

# AssemblyAI realtime websocket endpoint and model
ASSEMBLYAI_WS_BASE_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
ASSEMBLYAI_TRANSCRIBE_LANGUAGE=en

# Optional realtime tuning
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_END_UTTERANCE_SILENCE_THRESHOLD=700

# Optional override for caption backend target
CAPTION_BACKEND_URL=http://localhost:4010

# Bot tuning
BOT_DISPLAY_NAME=Melanam Note Bot
BOT_HEADLESS=1

# Join muted by default to avoid echo/feedback
BOT_JOIN_WITHOUT_AUDIO=1

# Windows capture defaults to WASAPI loopback; override if needed
BOT_CAPTURE_LOOPBACK=1
# BOT_WASAPI_DEVICE=default
# BOT_AUDIO_DEVICE=Speakers

# Optional legacy switch for dshow-based capture on Windows
# BOT_USE_DSHOW=1

# Optional: explicit ffmpeg path if ffmpeg is not on PATH
# BOT_FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe

# Linux only: PulseAudio source (sink.monitor)
# BOT_PULSE_SOURCE=g_meet_123456.monitor

# Optional: enable JWT-authenticated private rooms
JITSI_JWT_SECRET=your_jitsi_jwt_secret
JITSI_JWT_ISSUER=melanam

# ============================================
# MONGODB DATABASE
# ============================================
# Local: mongodb://localhost:27017/zoom-clone
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/zoom-clone
MONGODB_URI=mongodb://localhost:27017/zoom-clone


# Server recording control (Next.js server only; see SERVER_RECORDING.md)
RECORDING_WORKER_URL=http://127.0.0.1:4020
RECORDING_WORKER_SECRET=replace_with_long_random_shared_secret
# Private recording and LMS storage (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
