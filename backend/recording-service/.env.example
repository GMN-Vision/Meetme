# Copy to .env on the Linux recorder server. Do not commit credentials.
RECORDING_HOST=127.0.0.1
RECORDING_PORT=4020
RECORDING_WORKER_SECRET=replace-with-the-same-long-random-secret-as-the-app
RECORDING_APP_URL=https://your-app.example.com

# Dedicated recording instance; do not share with the livestream service.
JIBRI_SERVICE_URL=http://127.0.0.1:2222
# Only needed if an authenticated reverse proxy fronts Jibri:
JIBRI_API_SECRET=
JITSI_BASE_URL=https://meet.example.com
JIBRI_RECORDER_DOMAIN=recorder.meet.example.com
JIBRI_RECORDER_USERNAME=recorder
JIBRI_RECORDER_PASSWORD=replace-with-recorder-xmpp-password
JIBRI_RECORDINGS_PATH=/srv/melanam/recordings
RECORDING_STATE_PATH=/srv/melanam/recording-state

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
# Optional direct storage endpoint (recommended for hosted Supabase):
# SUPABASE_UPLOAD_URL=https://your-project.storage.supabase.co/storage/v1/upload/resumable
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
